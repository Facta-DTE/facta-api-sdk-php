{
    "name": "facta-dte/api",
    "description": "PHP client for the Facta DTE API (El Salvador electronic invoicing). No required dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "facta",
        "dte",
        "el-salvador",
        "factura-electronica",
        "api",
        "sdk"
    ],
    "homepage": "https://sdk.factadte.com",
    "support": {
        "issues": "https://github.com/Facta-DTE/facta-api-sdk-php/issues",
        "source": "https://github.com/Facta-DTE/facta-api-sdk-php"
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "nyholm/psr7": "^1.8",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "phpunit/phpunit": "^9.6",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "suggest": {
        "ext-curl": "Preferred HTTP transport; without it the SDK falls back to PHP streams.",
        "ext-openssl": "Needed for HTTPS without ext-curl, and for decrypting the local vault in later releases.",
        "psr/http-client": "To inject your own PSR-18 client (with a PSR-17 factory) through Psr18Transport."
    },
    "autoload": {
        "psr-4": {
            "Facta\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Facta\\Api\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs --standard=phpcs.xml.dist",
        "phpstan": "phpstan analyse --no-progress --memory-limit=512M",
        "compat": "phpcs --standard=phpcs.xml.dist",
        "build-zip": "@php scripts/build-zip.php",
        "check": [
            "@phpstan",
            "@compat",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite.",
        "compat": "PHPCompatibility check, PHP 7.4 and later.",
        "build-zip": "Build dist/facta-api-php-vX.Y.Z.zip for installs without Composer."
    }
}
